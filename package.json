{
  "name": "bookitty",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:fer": "node --import tsx --test tests/fer-preview.test.ts",
    "test:documents": "node --import tsx --test tests/document-learning.test.ts",
    "test:loading": "tsx --tsconfig tsconfig.app.json --test tests/loading-logo.test.tsx",
    "benchmark:invoices": "tsx tests/invoice-benchmark.ts",
    "test:invoice-parser": "tsx tests/invoice-benchmark.ts --check",
    "test:forex": "node --import tsx --test tests/forex.test.ts tests/currencies.test.ts",
    "test:reports": "node --import tsx --test tests/financial-report.test.ts",
    "test:dashboard": "node --import tsx --test tests/dashboard-metrics.test.ts",
    "test:kitty-history": "node --import tsx --test tests/kitty-chat-history.test.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.1.5",
    "i18next": "^26.0.3",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^5.4.624",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.13.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
